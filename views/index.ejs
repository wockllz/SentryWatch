<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>SentryWatch — uptime & security monitor</title>
<link rel="stylesheet" href="/css/style.css" />
</head>
<body>
<div class="shell">
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark">◎</div>
      <div>
        <div class="brand-title">SENTRYWATCH</div>
        <div class="brand-sub">SELF-HOSTED UPTIME &amp; SECURITY MONITOR</div>
      </div>
    </div>
    <div class="stats">
      <div class="stat"><span>MONITORS</span><strong id="s-monitors">0</strong></div>
      <div class="stat"><span>UP</span><strong id="s-up" class="good">0</strong></div>
      <div class="stat"><span>DOWN</span><strong id="s-down" class="bad">0</strong></div>
      <div class="stat"><span>AVG</span><strong id="s-avg">—</strong></div>
      <button class="btn ghost" id="refresh" type="button">REFRESH</button>
    </div>
  </header>

  <main class="layout">
    <section class="panel monitors">
      <div class="panel-head">
        <div>
          <span class="kicker">MONITORS</span>
          <h2>What we're watching</h2>
        </div>
        <button class="btn" id="add-toggle" type="button">+ ADD TARGET</button>
      </div>

      <form id="add-form" class="add-form hidden">
        <div class="grid2">
          <input id="t-name" placeholder="Name (e.g. My Portfolio)" />
          <input id="t-url" placeholder="https://example.com" />
          <input id="t-interval" type="number" min="5" value="60" placeholder="Interval (s)" />
          <input id="t-expected" type="number" min="100" max="599" value="200" placeholder="Expected status" />
          <input id="t-webhook" class="span2" placeholder="Alert webhook URL (optional)" />
        </div>
        <div class="row">
          <button class="btn" type="submit">START MONITORING</button>
          <span class="hint" id="add-hint"></span>
        </div>
      </form>

      <div id="targets" class="targets"></div>
      <p class="empty" id="empty">No monitors yet. Add a URL and SentryWatch will check it on a schedule.</p>
    </section>

    <aside class="side">
      <section class="panel">
        <div class="panel-head">
          <div>
            <span class="kicker">INCIDENTS</span>
            <h2>Recent incidents</h2>
          </div>
        </div>
        <div id="incidents" class="incidents"></div>
      </section>

      <section class="panel">
        <div class="panel-head">
          <div>
            <span class="kicker">SECURITY</span>
            <h2>Latest findings</h2>
          </div>
        </div>
        <div id="findings" class="findings"></div>
      </section>
    </aside>
  </main>

  <footer class="footer">
    <span>SENTRYWATCH · SELF-HOSTED · DOCKER READY</span>
    <span id="last-refresh">—</span>
  </footer>
</div>

<script src="/js/main.js"></script>
</body>
</html>
